<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BitchatWin.ViewModels"
        xmlns:svc="using:BitchatWin.Services"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="BitchatWin.MainWindow"
        x:CompileBindings="False"
        Title="bitchat · windows"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="460"
        Background="#080B08"
        FontFamily="Cascadia Mono,Consolas,Courier New,monospace">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0E140E" />
            <Setter Property="Foreground" Value="#D6F5D6" />
            <Setter Property="BorderBrush" Value="#1E2C1E" />
            <Setter Property="CaretBrush" Value="#7DF9A6" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Courier New,monospace" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#162416" />
            <Setter Property="Foreground" Value="#9BE8B4" />
            <Setter Property="BorderBrush" Value="#294029" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20351F" />
            <Setter Property="TextElement.Foreground" Value="#C8FFD8" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#5E735E" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="bitchat" Foreground="#7DF9A6" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChannelTitle}" Foreground="#D6F5D6" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding IdentityLine}" Classes="label" />
                <Border Background="#0E140E" BorderBrush="#1E2C1E" BorderThickness="1" CornerRadius="3" Padding="8,3">
                    <TextBlock Text="{Binding RelayStatus}" Foreground="{Binding RelayBrush}" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Channel controls -->
        <Border Grid.Row="1" Background="#0C110C" BorderBrush="#1A261A" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="canale" Classes="label" Width="52" />
                    <TextBox x:Name="GeohashBox" Text="{Binding GeohashInput}" Width="140" />
                    <Button x:Name="JoinButton" Content="entra" />
                    <Button x:Name="LeaveButton" Content="esci" IsEnabled="{Binding IsJoined}" />

                    <Rectangle Width="1" Fill="#1E2C1E" Margin="6,2" />

                    <TextBlock Text="nick" Classes="label" />
                    <TextBox x:Name="NicknameBox" Text="{Binding Nickname}" Width="150" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="da GPS" Classes="label" Width="52" />
                    <TextBlock Text="lat" Classes="label" />
                    <TextBox Text="{Binding Latitude}" Width="90" />
                    <TextBlock Text="lon" Classes="label" />
                    <TextBox Text="{Binding Longitude}" Width="90" />
                    <ComboBox x:Name="LevelBox" Width="160" SelectedIndex="2">
                        <ComboBoxItem Tag="2">region (2)</ComboBoxItem>
                        <ComboBoxItem Tag="4">province (4)</ComboBoxItem>
                        <ComboBoxItem Tag="5">city (5)</ComboBoxItem>
                        <ComboBoxItem Tag="6">quartiere (6)</ComboBoxItem>
                        <ComboBoxItem Tag="7">isolato (7)</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="DeriveButton" Content="calcola geohash" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Messages + people -->
        <Grid Grid.Row="2" ColumnDefinitions="*,10,230">
            <Border Grid.Column="0" Background="#0B0F0B" BorderBrush="#1A261A" BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="MessageScroller" Padding="10">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MessageRow">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="#4A5C4A"
                                               FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding NameBrush}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Content}" Foreground="#D6F5D6"
                                               FontSize="13" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#0B0F0B" BorderBrush="#1A261A" BorderThickness="1" CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{Binding PeopleHeader}" Foreground="#5E735E"
                               FontSize="12" Margin="10,8" />
                    <ScrollViewer Grid.Row="1" Padding="10,0,10,10">
                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="svc:Participant">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#A8C9A8"
                                               FontSize="13" Margin="0,2" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Composer -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBox Grid.Column="0" x:Name="DraftBox" Text="{Binding Draft}"
                     Watermark="scrivi un messaggio…" IsEnabled="{Binding IsJoined}" />
            <Button Grid.Column="1" x:Name="SendButton" Content="invia" Margin="8,0,0,0"
                    IsEnabled="{Binding IsJoined}" />
        </Grid>

        <!-- Log -->
        <Expander Grid.Row="4" Header="log" Margin="0,10,0,0" Background="#0B0F0B"
                  BorderBrush="#1A261A" Foreground="#5E735E">
            <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#6B7F6B" FontSize="11" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
